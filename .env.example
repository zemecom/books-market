APP_ENV=dev
APP_NAME='Books Market'
APP_URL=http://localhost:8080

DB_HOST=db
DB_PORT=3306
DB_NAME=books_catalog
DB_TEST_NAME=books_catalog_test
DB_USER=app
DB_PASSWORD=app

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=books_catalog
MYSQL_USER=app
MYSQL_PASSWORD=app

ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123
USER_LOGIN=user
USER_PASSWORD=user123

# SMS_TRANSPORT:
# - fake: внутренняя фейковая отправка без внешнего HTTP
# - smspilot: HTTP-вызов в SMSPilot
SMS_TRANSPORT=smpilot
# SMSPILOT_API_KEY: API ключ из личного кабинета SMSPilot.
SMSPILOT_API_KEY=
# SMSPILOT_SENDER: подтвержденное имя отправителя в SMSPilot.
# Можно оставить пустым, если отправитель не нужен.
SMSPILOT_SENDER=
# SMSPILOT_TEST:
# - 1: тестовый режим SMSPilot, реальной отправки не происходит
# - 0: боевая отправка
SMSPILOT_TEST=1
# SMSPILOT_TEST_PHONE: номер для ручной проверки SMS-интеграции.
SMSPILOT_TEST_PHONE=+79001234567

COVER_UPLOAD_DIR=/var/www/html/public/uploads
